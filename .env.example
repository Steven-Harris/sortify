# Sortify Backend Configuration
# Copy this file to .env and modify as needed

# Server Configuration
# Port for the HTTP server to listen on
PORT=8080

# Paths
# Directory where organized media files will be stored
MEDIA_PATH=./media

# Directory for temporary files during upload processing
TEMP_PATH=/tmp

# Logging
# Log level: debug, info, warn, error
LOG_LEVEL=info

# CORS Configuration
# Empty (default) = same-origin only (secure for production)
# For development with separate frontend server:
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# For production with reverse proxy from different domain:
# CORS_ORIGINS=https://yourdomain.com
# For completely open access (NOT recommended for production):
# CORS_ORIGINS=*
CORS_ORIGINS=

# Development Examples:
# CORS_ORIGINS=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production Examples:
# CORS_ORIGINS=https://yourdomain.com
# CORS_ORIGINS=https://photos.yourdomain.com,https://media.yourdomain.com
